# Discord Webhook URL for ticket alerts (Required for alerts)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord Mention Flag: @everyone, @here, <@&ROLE_ID>, or none (Default: @everyone)
DISCORD_MENTION=@everyone

# BookMyShow Region Slug (Default: karwar)
BMS_REGION=karwar

# Target movie keywords / regex pattern (case-insensitive)
TARGET_KEYWORDS=Ramayana,Ramayana: Part 1,Ramayana - Part 1

# Optional: Force test alert on run (true/false)
TEST_ALERT=false

# Optional: Force alert even if state.json says already alerted (true/false)
FORCE_ALERT=false

